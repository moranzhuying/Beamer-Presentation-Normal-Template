% ================================================================
% [模块 II] 定理与证明环境
% ================================================================
% 与「笔记写作」语义完全一致:
%   用法        : \begin{环境名}{标题}{label} ... \end{环境名}
%   编号类环境  : 共用 mathcount 计数器, 按 section 编号 (如 定理 1.1)
%   习题        : 独立计数器 exercisecount
%   引用        : \ref{label} (Beamer 内置 hyperref, 无需 cleveref)
% 视觉由 Beamer 原生盒子实现 (支持 \pause 等 overlay 指令),
% 样式为「顶部细色条 + 主色标题 + 浅色盒底」, 深浅模式自动适配。

% -------- 2.1 计数器 --------
\newcounter{mathcount}[section]
\renewcommand{\themathcount}{\thesection.\arabic{mathcount}}

\newcounter{exercisecount}[section]
\renewcommand{\theexercisecount}{\thesection.\arabic{exercisecount}}

% -------- 2.2 基础排版宏 --------
% 顶部色条 + 标题行
\newcommand{\yukina@blockhead}[3]{%
  \par\vskip\smallskipamount
  \noindent{\color{\yukinaline{#2}}\rule{\textwidth}{1.8pt}}\par
  \vskip 3pt
  \noindent{\usebeamerfont{block title}\color{\yukinac{#2}}\textbf{#1}%
    \ifstrempty{#3}{}{\ \normalfont #3}}\par
  \vskip\smallskipamount
}
% 盒体开始/结束
\newcommand{\yukina@blockbodybegin}{%
  \begin{beamercolorbox}[wd=\textwidth,leftskip=10pt,rightskip=10pt,sep=5pt]{block body}%
}
\newcommand{\yukina@blockbodyend}{%
  \end{beamercolorbox}%
  \par\vskip\smallskipamount
}

% -------- 2.3 编号环境批量定义 --------
% \yukina@defthm{环境名}{中文名}{主色}{计数器}
\newcommand{\yukina@defthm}[4]{%
  \newenvironment{#1}[2]{%
    \refstepcounter{#4}%
    \ifstrempty{##2}{}{\label{##2}}%
    \setbeamercolor{block body}{bg=\yukinabg{#3}, fg=textcolor}%
    \yukina@blockhead{#2~\csname the#4\endcsname}{#3}{##1}%
    \yukina@blockbodybegin
  }{%
    \yukina@blockbodyend
  }%
}

% -------- 2.4 旧环境清理 (Beamer 自带部分同名环境) --------
\let\theorem\relax\let\endtheorem\relax
\let\lemma\relax\let\endlemma\relax
\let\proposition\relax\let\endproposition\relax
\let\corollary\relax\let\endcorollary\relax
\let\example\relax\let\endexample\relax
\let\definition\relax\let\enddefinition\relax
\let\proof\relax\let\endproof\relax
\let\exercise\relax\let\endexercise\relax
\let\problem\relax\let\endproblem\relax
\let\solution\relax\let\endsolution\relax

% -------- 2.5 编号环境 (与书籍版一一对应) --------
% -- 基础陈述: 蓝 / 靛蓝 / 青 --
\yukina@defthm{definition}{定义}{mainblue}{mathcount}
\yukina@defthm{axiom}{公理}{mainindigo}{mathcount}
\yukina@defthm{hypothesis}{假设}{mainteal}{mathcount}

% -- 推演结果: 每类独立主色 --
\yukina@defthm{theorem}{定理}{mainred}{mathcount}
\yukina@defthm{lemma}{引理}{mainorange}{mathcount}
\yukina@defthm{proposition}{命题}{mainpurple}{mathcount}
\yukina@defthm{corollary}{推论}{maingreen}{mathcount}
\yukina@defthm{metatheorem}{元定理}{mainindigo}{mathcount}
\yukina@defthm{criteria}{准则}{mainbrown}{mathcount}

% -- 补充说明: 问题 / 例 / 注记 --
\yukina@defthm{problem}{问题}{mainyellow}{mathcount}
\yukina@defthm{example}{例}{maingreen}{mathcount}
\yukina@defthm{remark}{注记}{maingray}{mathcount}

% -- 习题: 独立计数器, 品红醒目 --
\yukina@defthm{exercise}{习题}{mainmagenta}{exercisecount}

% -- 其他: 算法 / 约定 / 警示 / 分析 --
\yukina@defthm{algorithm}{算法}{mainorange}{mathcount}
\yukina@defthm{convention}{约定}{mainbrown}{mathcount}
\yukina@defthm{alarm}{警示}{mainred}{mathcount}
\yukina@defthm{sketch}{分析}{mainpurple}{mathcount}

% -------- 2.6 证明 / 回答 / 解答 / 提示 --------
% -- 证明: 灰色细线, 自动加证毕符号 ∎ --
% 注意: 上方已 \let\proof\relax, 故用 \newenvironment 而非 \renewenvironment。
\newenvironment{proof}[1][证明]{%
  \par\vskip\smallskipamount
  \noindent{\color{\yukinaline{maingray}}\rule{\textwidth}{1.2pt}}\par
  \vskip 3pt
  \noindent{\usebeamerfont{block title}\color{\yukinac{maingray}}\textbf{#1}}\par
  \vskip\smallskipamount
  \setbeamercolor{block body}{bg=backgroundcolor, fg=textcolor}%
  \begin{beamercolorbox}[wd=\textwidth,leftskip=10pt,rightskip=10pt,sep=5pt]{block body}%
}{%
  \hfill$\square$%
  \end{beamercolorbox}%
  \par\vskip\smallskipamount
}

% -- 回答: 灰色细线 --
\newenvironment{answer}{%
  \par\vskip\smallskipamount
  \noindent{\color{\yukinaline{maingray}}\rule{\textwidth}{1.2pt}}\par
  \vskip 3pt
  \noindent{\usebeamerfont{block title}\color{\yukinac{maingray}}\textbf{回答}}\par
  \vskip\smallskipamount
  \setbeamercolor{block body}{bg=\yukinabg{maingray}, fg=textcolor}%
  \begin{beamercolorbox}[wd=\textwidth,leftskip=10pt,rightskip=10pt,sep=5pt]{block body}%
}{%
  \end{beamercolorbox}%
  \par\vskip\smallskipamount
}

% -- 解答: 题后即答 (习题专用) --
\newenvironment{solution}{%
  \par\vskip\smallskipamount
  \noindent{\color{\yukinaline{maingray}}\rule{\textwidth}{1.2pt}}\par
  \vskip 3pt
  \noindent{\usebeamerfont{block title}\color{\yukinac{maingray}}\textbf{解答}}\par
  \vskip\smallskipamount
  \setbeamercolor{block body}{bg=\yukinabg{maingray}, fg=textcolor}%
  \begin{beamercolorbox}[wd=\textwidth,leftskip=10pt,rightskip=10pt,sep=5pt]{block body}%
}{%
  \end{beamercolorbox}%
  \par\vskip\smallskipamount
}

% -- 提示: 可选参数为标题, 黄底茶色 --
\newenvironment{hint}[1][提示]{%
  \par\vskip\smallskipamount
  \noindent{\color{\yukinaline{mainyellow}}\rule{\textwidth}{1.2pt}}\par
  \vskip 3pt
  \noindent{\usebeamerfont{block title}\color{\yukinac{mainbrown}}\textbf{#1}}\par
  \vskip\smallskipamount
  \setbeamercolor{block body}{bg=\yukinabg{mainyellow}, fg=textcolor}%
  \begin{beamercolorbox}[wd=\textwidth,leftskip=10pt,rightskip=10pt,sep=5pt]{block body}%
}{%
  \end{beamercolorbox}%
  \par\vskip\smallskipamount
}

% -------- 2.7 代码环境 (listings, 需放在 fragile 帧中) --------
\lstdefinestyle{yukinacode}{%
  basicstyle=\ttfamily\small,
  breaklines=true,
  columns=fullflexible,
  keepspaces=true,
  showstringspaces=false,
  backgroundcolor=\color{\yukinabg{maingray}},
}
\lstnewenvironment{code}[1][]{%
  \lstset{style=yukinacode,
    title={\ifstrempty{#1}{代码}{代码：{#1}}},
    aboveskip=\smallskipamount,
    belowskip=\smallskipamount}
}{}


% ================================================================
% [模块 III] 引用与超链接
% ================================================================
% hyperref 由 Beamer 内置, 直接用 \ref / \label 即可。
% 习题引用笔记宏 (与书籍版一致):
%   模式 1 (独立习题集): 展开为 \ref{note-标签} (跨文档引用);
%   模式 2 (讲义内嵌)  : 在 main.tex 中 \renewcommand{\noteref}[1]{\ref{#1}} 覆盖。
\providecommand{\noteref}[1]{\ref{note-#1}}


