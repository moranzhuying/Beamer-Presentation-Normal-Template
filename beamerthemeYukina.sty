\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeYukina}[2026/08/27 Beamer theme by Yukina]

% ================================================================
% beamerthemeYukina.sty — 与「笔记写作」配套的 Beamer 主题
% ----------------------------------------------------------------
% 用法: \usetheme[light]{Yukina}  浅色模式 (白底, 默认)
%       \usetheme[dark]{Yukina}   深色模式 (深底)
%
% 模块划分:
%   I.   模式开关 (light / dark)
%   II.  配色体系 (学术 11 色 + 背景/文字/强调色)
%   III. 字体设置
%   IV.  帧元素模板 (frametitle / footline / itemize / 标题页 / 节标题帧)
%
% 与「笔记写作」structure.sty 的对应关系:
%   模块 IV 的 11 种学术配色原样保留;
%   ctexset / titlesec / fancyhdr 由 Beamer 模板机制替代。
% ================================================================


% ================================================================
% [模块 I] 模式开关
% ================================================================
% 浅色模式: 白底深字; 深色模式: 深底浅字, 主色自动亮化。
\newif\ifyukinadark
\DeclareOptionBeamer{dark}{\yukinadarktrue}
\DeclareOptionBeamer{light}{\yukinadarkfalse}
\ExecuteOptionsBeamer{light}
\ProcessOptionsBeamer


% ================================================================
% [模块 II] 配色体系
% ================================================================

% -------- 2.1 学术 11 色 (与「笔记写作」4.2 节一致) --------
% 蓝:定义  靛蓝:公理/元定理  青:假设  红:定理/警示
% 橙:引理/算法  紫:命题/分析  绿:推论/例  茶:准则/约定
% 黄:提示/注意  品红:习题  灰:证明/回答/注记/代码
\definecolor{mainblue}{RGB}{25, 95, 170}
\definecolor{mainindigo}{RGB}{65, 75, 160}
\definecolor{mainteal}{RGB}{0, 125, 140}
\definecolor{mainred}{RGB}{180, 45, 55}
\definecolor{mainorange}{RGB}{210, 100, 25}
\definecolor{mainpurple}{RGB}{115, 70, 155}
\definecolor{maingreen}{RGB}{40, 125, 75}
\definecolor{mainbrown}{RGB}{145, 90, 45}
\definecolor{mainyellow}{RGB}{195, 135, 0}
\definecolor{mainmagenta}{RGB}{190, 55, 95}
\definecolor{maingray}{RGB}{80, 80, 80}

% -------- 2.2 页面背景 / 文字 / 强调色 --------
\ifyukinadark
    \definecolor{backgroundcolor}{RGB}{22, 26, 34}      % 深蓝黑背景
    \definecolor{textcolor}{RGB}{226, 230, 238}         % 浅灰文字
    \definecolor{accentcolor}{RGB}{125, 180, 235}       % 亮蓝强调
    \newcommand{\yukinac}[1]{#1!75!white}               % 主色亮化 (标题用)
    \newcommand{\yukinabg}[1]{#1!30!backgroundcolor}    % 盒底: 主色混背景
    \newcommand{\yukinaline}[1]{#1!40!backgroundcolor}  % 细线: 主色混背景
\else
    \definecolor{backgroundcolor}{RGB}{255, 255, 255}   % 白底
    \definecolor{textcolor}{RGB}{30, 30, 30}            % 深灰文字
    \definecolor{accentcolor}{RGB}{25, 95, 170}         % mainblue
    \newcommand{\yukinac}[1]{#1}                        % 主色原样
    \newcommand{\yukinabg}[1]{#1!7!white}               % 盒底: 主色!7!白
    \newcommand{\yukinaline}[1]{#1!35!white}            % 细线: 主色!35!白
\fi

% -------- 2.3 Beamer 颜色映射 --------
\setbeamercolor{background canvas}{bg=backgroundcolor}
\setbeamercolor{normal text}{fg=textcolor}
\setbeamercolor{structure}{fg=accentcolor}
\setbeamercolor{frametitle}{fg=textcolor}
\setbeamercolor{framesubtitle}{fg=textcolor!70!backgroundcolor}
\setbeamercolor{title}{fg=accentcolor}
\setbeamercolor{author}{fg=textcolor}
\setbeamercolor{date}{fg=textcolor}
\setbeamercolor{institute}{fg=textcolor}
\setbeamercolor{footline}{fg=textcolor!55!backgroundcolor}
\setbeamercolor{item}{fg=accentcolor}
\setbeamercolor{caption name}{fg=accentcolor}
\setbeamercolor{section in head/foot}{fg=accentcolor}            % 导航: 当前节
\setbeamercolor{section in head/foot shaded}{fg=textcolor!45!backgroundcolor}  % 导航: 其他节
\setbeamercolor{section in toc}{fg=textcolor}
\setbeamercolor{section in toc shaded}{fg=textcolor!60!backgroundcolor}
\setbeamercolor{subsection in toc}{fg=textcolor!75!backgroundcolor}


% ================================================================
% [模块 III] 字体设置
% ================================================================
% 正文与数学用衬线 (贴近书籍观感, 与笔记模板一致);
% 西文主字体 TeX Gyre Termes (Times 风格), 中文由 ctexbeamer 处理。
\usefonttheme{serif}
\setmainfont{TeX Gyre Termes}

\setbeamerfont{frametitle}{size=\Large, series=\bfseries}
\setbeamerfont{framesubtitle}{size=\normalsize, series=\mdseries}
\setbeamerfont{title}{size=\Huge, series=\bfseries}
\setbeamerfont{author}{size=\large}
\setbeamerfont{date}{size=\normalsize}
\setbeamerfont{footline}{size=\scriptsize}
\setbeamerfont{block title}{size=\normalsize, series=\bfseries}


% ================================================================
% [模块 IV] 帧元素模板
% ================================================================

% -------- 4.1 frametitle: 左侧竖色条 + 标题 + 底部细线 --------
\defbeamertemplate{frametitle}{yukina}{%
  \noindent\vrule width 3pt height 1.3em depth 0.3em\hskip 8pt%
  {\usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}\insertframetitle}\par%
  \ifx\insertframesubtitle\empty\else
    \vskip 2pt
    \hskip 11pt{\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle}\par
  \fi
  \vskip 3pt
  {\color{\yukinaline{accentcolor}}\hrule height 0.6pt}%
  \vskip 6pt
}
\setbeamertemplate{frametitle}[yukina]

% -------- 4.2 footline: 进度条 + 章节导航 + 作者信息 + 页码 --------
% 四要素 (自下而上):
%   行 3 作者信息 : 作者 · 单位 · 日期 (均自动省略为空项), 右端页码 n/N;
%   行 2 章节导航 : 所有 section 带编号水平排列, 当前节高亮, 点击跳转
%                   (beamer 内置 \insertsectionnavigationhorizontal);
%   行 1 进度条   : 按 当前帧/总帧 比例填充主题色。
% 导航符号 (前进/后退箭头等) 由 beamer 自动显示在右下角 (footline 上方)。
\newif\ifyukina@shown
\newcommand{\yukina@show}[1]{%
  \ifyukina@shown\ \textbar\ \fi
  #1\yukina@showntrue
}
\defbeamertemplate{footline}{yukina}{%
  % -- 行 3: 作者 · 单位 · 日期 + 页码 --
  \begin{beamercolorbox}[wd=\paperwidth,ht=2.4ex,dp=1ex,leftskip=8pt,rightskip=8pt]{footline}%
    \usebeamerfont{footline}\usebeamercolor[fg]{footline}%
    \yukina@shownfalse
    \ifx\beamer@shortauthor\empty\else\yukina@show{\insertshortauthor}\fi
    \ifcsname beamer@shortinstitute\endcsname
      \ifx\beamer@shortinstitute\empty\else\yukina@show{\insertshortinstitute}\fi
    \fi
    \ifx\insertshortdate\empty\else\yukina@show{\insertshortdate}\fi
    \hfill\insertframenumber/\inserttotalframenumber%
  \end{beamercolorbox}%
  % -- 行 2: 章节导航 (带编号) --
  \begin{beamercolorbox}[wd=\paperwidth,ht=3.2ex,dp=1ex,leftskip=8pt,rightskip=8pt]{footline}%
    \usebeamerfont{footline}\usebeamercolor[fg]{footline}%
    \insertsectionnavigationhorizontal{\dimexpr\paperwidth-16pt}{}{}%
  \end{beamercolorbox}%
  % -- 行 1: 进度条 --
  \begin{beamercolorbox}[wd=\paperwidth,ht=2pt]{progress bar}%
    \hbox to \paperwidth{%
      \color{\yukinac{accentcolor}}%
      \leaders\hrule height 2pt\hskip\dimexpr\paperwidth*\insertframenumber/\inserttotalframenumber\relax
      \color{\yukinaline{accentcolor}}%
      \leaders\hrule height 2pt\hfill
    }%
  \end{beamercolorbox}%
}
\setbeamertemplate{footline}[yukina]
\setbeamerfont{section in head/foot}{size=\scriptsize}

% -------- 4.3 章节导航模板: 带编号 (编号由 beamer 提供 \insertsectionheadnumber) --------
\defbeamertemplate{section in head/foot}{yukina}{%
  \insertsectionheadnumber.\,\insertsectionhead%
}
\defbeamertemplate{section in head/foot shaded}{yukina}{%
  \insertsectionheadnumber.\,\insertsectionhead%
}
\setbeamertemplate{section in head/foot}[yukina]
\setbeamertemplate{section in head/foot shaded}[yukina]
% 目录帧: 显示节编号 (1. 基础帧, 2. 进阶帧)
\setbeamertemplate{section in toc}[sections numbered]
\setbeamertemplate{subsection in toc}[sections numbered]

% -------- 4.4 导航符号: 恢复 beamer 默认 (右下角前进/后退等图标) --------
% 保持默认模板即可; 若想隐藏, 改为 \setbeamertemplate{navigation symbols}{}。

% -------- 4.4 itemize: 沿用笔记模板符号 ◆ ▷ ∗ --------
\setbeamertemplate{itemize item}{$\diamond$}
\setbeamertemplate{itemize subitem}{$\triangleright$}
\setbeamertemplate{itemize subsubitem}{$\ast$}
\setbeamertemplate{enumerate item}{\insertenumlabel.}
\setbeamertemplate{enumerate subitem}{\insertsubenumlabel.}
\setbeamertemplate{enumerate subsubitem}{\insertsubsubenumlabel.}

% -------- 4.5 标题页: 居中, 标题主色; 作者/日期/机构为空时自动省略 --------
% 判断基于宏定义是否为空 (\ifx...\empty), 比 \ifstrempty 更可靠:
% beamer 初始化时已调用 \author{} \date{}, 故对应宏一定存在。
\defbeamertemplate{title page}{yukina}{%
  \centering
  \vfill
  {\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle\par}%
  \ifx\beamer@shortauthor\empty\else
    \vskip 1.2em
    {\usebeamerfont{author}\usebeamercolor[fg]{author}\insertauthor\par}%
  \fi
  \ifx\insertdate\empty\else
    \vskip 0.6em
    {\usebeamerfont{date}\usebeamercolor[fg]{date}\insertdate\par}%
  \fi
  \ifcsname beamer@shortinstitute\endcsname
    \ifx\beamer@shortinstitute\empty\else
      \vskip 0.6em
      {\usebeamerfont{institute}\usebeamercolor[fg]{institute}\insertinstitute\par}%
    \fi
  \fi
  \vfill
}
\setbeamertemplate{title page}[yukina]

% -------- 4.6 图片标题: 小字号, 名称主色 --------
\setbeamertemplate{caption}{\insertcaption}
\setbeamerfont{caption}{size=\scriptsize}

% -------- 4.7 节标题帧: 每节开头自动插入, 显示节编号 --------
% 若不需要, 在 main.tex 导言区写 \AtBeginSection{} 即可关闭。
\AtBeginSection[]{%
  \begin{frame}[plain,noframenumbering]
    \centering
    \vfill
    {\usebeamerfont{frametitle}\usebeamercolor[fg]{structure}%
     \insertsectionnumber.\quad\insertsectionhead\par}
    \vfill
  \end{frame}
}
